# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 가져온다.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# service_role key 는 여기에도, 앱 어디에도 두지 않는다. RLS를 통째로 우회하는 열쇠다.

# RLS 격리 테스트(scripts/rls-isolation-test.mjs)용. 플러스 별칭을 받는 주소면 된다.
RLS_TEST_EMAIL_BASE=
